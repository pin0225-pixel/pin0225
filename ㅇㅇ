<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>영화 추천 및 포럼 사이트</title>

    <!-- [필수] link 태그: 외부 폰트 모듈 연결 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ==========================================
           [필수 CSS 속성 전체 포함]
           - background-color, border, width, height, 
             margin, padding, display(inline-block, flex)
           ========================================== */

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #0a0a0a;
            color: #ffffff;
            font-family: 'Pretendard', sans-serif;
            padding: 10px;
        }

        /* 1. 좌측 상단 메뉴/로그인/설정 바 */
        #top-bar {
            display: flex;
            background-color: #141414;
            padding: 10px 15px;
            border: 1px solid #333333;
            margin-bottom: 10px;
            width: 100%;
            height: 50px;
            align-items: center;
        }

        .top-left-group {
            display: flex;
            align-items: center;
        }

        .menu-btn {
            background-color: transparent;
            color: #ffffff;
            border: none;
            font-size: 20px;
            margin-right: 15px;
            cursor: pointer;
            display: inline-block;
        }

        .top-nav-link {
            color: #cccccc;
            text-decoration: none;
            margin-right: 15px;
            font-size: 14px;
            display: inline-block;
            padding: 5px;
        }

        .top-nav-link:hover {
            color: #e50914;
        }

        /* 메인 브랜드 타이틀 */
        .site-title {
            margin-left: auto;
            color: #e50914;
            font-size: 20px;
            display: inline-block;
        }

        /* 2. 헤더 영역 (영화 광고 문구 배너) */
        #header-banner {
            background-color: #e50914;
            color: #ffffff;
            padding: 30px 20px;
            margin-bottom: 15px;
            width: 100%;
            text-align: center;
            border: 1px solid #ff1e27;
        }

        #header-banner h2 {
            font-size: 24px;
            margin-bottom: 8px;
        }

        #header-banner p {
            font-size: 14px;
        }

        /* 3. 검색 바 영역 */
        #search-container {
            display: flex;
            margin-bottom: 25px;
            width: 100%;
            justify-content: center;
        }

        .search-box {
            display: flex;
            width: 90%;
            max-width: 500px;
            background-color: #ffffff;
            border: 2px solid #ffffff;
            padding: 8px 15px;
            height: 42px;
            align-items: center;
            border-radius: 20px;
        }

        .search-input {
            width: 100%;
            border: none;
            outline: none;
            padding: 5px;
            font-size: 14px;
            background-color: transparent;
        }

        .search-icon {
            display: inline-block;
            color: #333333;
            font-size: 16px;
            margin-left: 5px;
        }

        /* 4. 관심 영역 (추천 영화 스크롤) */
        #recommend-section {
            background-color: #121212;
            padding: 15px;
            margin-bottom: 25px;
            width: 100%;
            border: 1px solid #222222;
        }

        .section-title {
            color: #ffffff;
            font-size: 18px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }

        .star-icon {
            color: #ff0000;
            margin-right: 8px;
            display: inline-block;
        }

        .carousel-wrapper {
            display: flex;
            align-items: center;
            width: 100%;
        }

        .cards-container {
            display: flex;
            width: 100%;
            overflow-x: auto;
            padding-bottom: 10px;
        }

        .movie-card {
            display: flex;
            flex-direction: column;
            background-color: #1f1f1f;
            width: 140px;
            height: 230px;
            margin-right: 12px;
            padding: 8px;
            border: 1px solid #333333;
            flex-shrink: 0;
            text-align: center;
        }

        .movie-card img {
            width: 100%;
            height: 140px;
            margin-bottom: 8px;
            border: 1px solid #444444;
        }

        .movie-card span {
            font-size: 12px;
            color: #dddddd;
            display: inline-block;
            margin-top: 4px;
        }

        .arrow-btn {
            display: inline-block;
            background-color: #222222;
            color: #ffffff;
            border: 1px solid #444444;
            width: 35px;
            height: 70px;
            margin-left: 8px;
            font-size: 20px;
            cursor: pointer;
        }

        /* 5. 컨텐츠 영역 (하단 노란 테두리 포럼 & 글쓰기 세로 분할) */
        #content-section {
            display: flex;
            width: 100%;
            margin-bottom: 20px;
            gap: 15px;
        }

        /* 노란색 테두리가 적용된 좌/우 프레임 */
        .yellow-box {
            background-color: #111111;
            border: 2px solid #ffd700; /* 노란색 테두리 */
            padding: 15px;
            height: auto;
        }

        /* 좌측: 포럼 */
        #forum-area {
            width: 60%;
        }

        /* 우측: 글쓰기 */
        #write-area {
            width: 40%;
        }

        /* 표 (table) 스타일링 */
        .forum-table {
            width: 100%;
            border: 1px solid #333333;
            margin-top: 10px;
            margin-bottom: 15px;
        }

        .forum-table th, .forum-table td {
            border: 1px solid #333333;
            padding: 8px;
            text-align: left;
            font-size: 12px;
        }

        .forum-table th {
            background-color: #222222;
            color: #ffd700;
        }

        .forum-table td {
            background-color: #181818;
        }

        /* 리스트 (ul, ol) 스타일 */
        .forum-tags-list {
            margin-left: 20px;
            padding: 5px;
        }

        .rules-list {
            margin-left: 20px;
            padding: 5px;
            margin-top: 5px;
            color: #aaaaaa;
            font-size: 12px;
        }

        .rules-list li, .forum-tags-list li {
            margin-bottom: 4px;
        }

        /* 글쓰기 폼 스타일 */
        .form-group {
            margin-bottom: 10px;
        }

        .form-group label {
            display: inline-block;
            margin-bottom: 4px;
            font-size: 12px;
            color: #ffd700;
        }

        .form-input, .form-textarea {
            width: 100%;
            background-color: #222222;
            border: 1px solid #444444;
            color: #ffffff;
            padding: 8px;
            font-size: 12px;
        }

        .form-textarea {
            height: 80px;
        }

        .submit-btn {
            display: inline-block;
            background-color: #ffd700;
            color: #000000;
            border: none;
            padding: 8px 15px;
            width: 100%;
            font-weight: bold;
            cursor: pointer;
            margin-top: 5px;
        }

        /* 사이드바 메뉴 (모달/슬라이드) */
        #sidebar {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 220px;
            height: 100%;
            background-color: #141414;
            border-right: 2px solid #ffd700;
            padding: 20px;
            z-index: 100;
        }

        #sidebar h3 {
            margin-bottom: 15px;
            color: #ffd700;
        }

        #sidebar ul {
            list-style: none;
        }

        #sidebar li {
            margin-bottom: 12px;
        }

        #sidebar a {
            color: #ffffff;
            text-decoration: none;
            display: inline-block;
        }

        .close-sidebar {
            background-color: #e50914;
            color: #ffffff;
            border: none;
            padding: 5px 10px;
            margin-bottom: 15px;
            cursor: pointer;
            display: inline-block;
        }
    </style>
</head>
<body>

    <!-- 5. 사이드 메뉴 슬라이드 영역 -->
    <div id="sidebar">
        <button class="close-sidebar" onclick="toggleSidebar()">✕ 닫기</button>
        <h3>사이드 메뉴</h3>
        <ul>
            <li><a href="#profile">내 프로필</a></li>
            <li><a href="#history">시청 기록</a></li>
            <li><a href="#bookmarks">북마크 영화</a></li>
            <li><a href="#settings">설정</a></li>
        </ul>
    </div>

    <!-- 1. 좌측 상단 로그인 및 설정 바 -->
    <div id="top-bar">
        <div class="top-left-group">
            <button class="menu-btn" onclick="toggleSidebar()">☰</button>
            <a href="#" class="top-nav-link" onclick="alert('로그인 창으로 이동합니다.')">로그인</a>
            <a href="#" class="top-nav-link" onclick="alert('설정 페이지로 이동합니다.')">설정</a>
        </div>
        <h1 class="site-title">CINEMA HUB</h1>
    </div>

    <!-- 1. 헤더 영역 (영화 찾아보라는 광고 문구) -->
    <div id="header-banner">
        <h2>어떤 영화를 볼지 고민이신가요?</h2>
        <p>지금 검색창에서 원하는 영화를 찾아보고 취향에 맞는 작품을 감상하세요!</p>
    </div>

    <!-- 검색 바 영역 -->
    <div id="search-container">
        <div class="search-box">
            <input type="text" class="search-input" id="search-input" placeholder="검색 바(search)">
            <span class="search-icon">🔍</span>
        </div>
    </div>

    <!-- 2. 본문 & 4. 관심 영역 (검색기록 기준 추천 영화) -->
    <div id="recommend-section">
        <div class="section-title">
            <span class="star-icon">★</span>
            <h3>관심 영역 (사용자 취향 맞춤 추천)</h3>
        </div>

        <div class="carousel-wrapper">
            <div class="cards-container" id="cards-container">
                <!-- 영화 카드 1 -->
                <div class="movie-card">
                    <img src="https://picsum.photos/140/140?random=1" alt="인터스텔라 포스터">
                    <span>인터스텔라</span>
                    <span>장르: SF</span>
                </div>

                <!-- 영화 카드 2 -->
                <div class="movie-card">
                    <img src="https://picsum.photos/140/140?random=2" alt="다크 나이트 포스터">
                    <span>다크 나이트</span>
                    <span>장르: 액션</span>
                </div>

                <!-- 영화 카드 3 -->
                <div class="movie-card">
                    <img src="https://picsum.photos/140/140?random=3" alt="인셉션 포스터">
                    <span>인셉션</span>
                    <span>장르: SF/스릴러</span>
                </div>

                <!-- 검색기록 기준 추천영화 카드 -->
                <div class="movie-card" style="border: 1px solid #ffd700;">
                    <img src="https://picsum.photos/140/140?random=4" alt="검색기록 기준 추천영화 포스터">
                    <span><strong>검색기록 기준<br>추천영화</strong></span>
                    <span>아바타: 물의 길</span>
                </div>
            </div>

            <!-- 우측 화살표 스크롤 버튼 -->
            <button class="arrow-btn" onclick="scrollCarousel()">&gt;</button>
        </div>
    </div>

    <!-- 3. 컨텐츠 영역 (하단: 포럼 및 글쓰기 세로 분할) -->
    <div id="content-section">
        
        <!-- 좌측: 포럼 (노란색 테두리) -->
        <div id="forum-area" class="yellow-box">
            <h2>포럼 (Forum)</h2>
            <p>영화에 대한 다양한 의견과 리뷰를 확인해 보세요.<br>자유롭게 토론에 참여할 수 있습니다.</p>
            
            <!-- [필수] 표(table, tr, th, td) 태그 -->
            <table class="forum-table">
                <thead>
                    <tr>
                        <th>번호</th>
                        <th>영화 제목</th>
                        <th>토론 주제</th>
                        <th>작성자</th>
                    </tr>
                </thead>
                <tbody id="forum-list">
                    <tr>
                        <td>1</td>
                        <td>인터스텔라</td>
                        <td>결말 해석에 관한 자유로운 토론</td>
                        <td>시네필99</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>인셉션</td>
                        <td>팽이는 결국 도는가 멈추는가?</td>
                        <td>무비마스터</td>
                    </tr>
                </tbody>
            </table>

            <h3>인기 토론 키워드</h3>
            <!-- [필수] ul, li 태그 -->
            <ul class="forum-tags-list">
                <li>#반전영화</li>
                <li>#SF명작</li>
                <li>#OST최고의영화</li>
            </ul>
        </div>

        <!-- 우측: 글쓰기 (노란색 테두리) -->
        <div id="write-area" class="yellow-box">
            <h2>글쓰기 (Write)</h2>
            <p>새로운 영화 토론글을 작성하세요.</p>
            <br>

            <form onsubmit="addPost(event)">
                <div class="form-group">
                    <label for="movie-title">영화 제목</label>
                    <input type="text" id="movie-title" class="form-input" required placeholder="예: 아바타">
                </div>

                <div class="form-group">
                    <label for="post-title">글 제목</label>
                    <input type="text" id="post-title" class="form-input" required placeholder="제목을 입력하세요">
                </div>

                <div class="form-group">
                    <label for="post-content">내용</label>
                    <textarea id="post-content" class="form-textarea" required placeholder="내용을 입력하세요"></textarea>
                </div>

                <button type="submit" class="submit-btn">작성 완료</button>
            </form>

            <br>
            <h3>포럼 작성 수칙</h3>
            <!-- [필수] ol, li 태그 -->
            <ol class="rules-list">
                <li>스포일러 포함 시 제목에 표시</li>
                <li>타인에 대한 비방 금지</li>
            </ol>
        </div>

    </div>

    <!-- 간단한 JavaScript 동작 -->
    <script>
        // 사이드바 토글
        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            if (sidebar.style.display === 'block') {
                sidebar.style.display = 'none';
            } else {
                sidebar.style.display = 'block';
            }
        }

        // 카루셀 오른쪽 스크롤
        function scrollCarousel() {
            var container = document.getElementById('cards-container');
            container.scrollBy({ left: 150, behavior: 'smooth' });
        }

        // 포럼 글 추가 기능
        function addPost(e) {
            e.preventDefault();
            var movieTitle = document.getElementById('movie-title').value;
            var postTitle = document.getElementById('post-title').value;

            var tbody = document.getElementById('forum-list');
            var rowCount = tbody.rows.length + 1;

            var newRow = tbody.insertRow();
            newRow.insertCell(0).innerText = rowCount;
            newRow.insertCell(1).innerText = movieTitle;
            newRow.insertCell(2).innerText = postTitle;
            newRow.insertCell(3).innerText = "나(User)";

            alert('글이 성공적으로 등록되었습니다!');
            document.getElementById('movie-title').value = '';
            document.getElementById('post-title').value = '';
            document.getElementById('post-content').value = '';
        }
    </script>
</body>
</html>
